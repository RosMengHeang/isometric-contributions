{
  "name": "isometric-contributions",
  "version": "0.2.0",
  "description": "GitHub contribution calendar as an isometric 3D city, a 2D skyline, or a classic grid. React component, static SVG renderer, CLI, and GitHub Action.",
  "license": "MIT",
  "author": "Ros MengHeang (Taxzy) (https://taxzy.dev)",
  "homepage": "https://taxzy.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RosMengHeang/isometric-contributions.git"
  },
  "bugs": {
    "url": "https://github.com/RosMengHeang/isometric-contributions/issues"
  },
  "keywords": [
    "react",
    "typescript",
    "github",
    "contributions",
    "calendar",
    "isometric",
    "svg",
    "city",
    "skyline",
    "3d",
    "portfolio",
    "readme",
    "github-action",
    "cli"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "isometric-contributions": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./contributions": {
      "types": "./dist/contributions.d.ts",
      "default": "./dist/contributions.js"
    },
    "./svg": {
      "types": "./dist/svg.d.ts",
      "default": "./dist/svg.js"
    },
    "./styles.css": "./dist/iso-styles.css"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run build:lib && npm run build:demo",
    "build:lib": "tsc -p tsconfig.build.json && node scripts/postbuild.mjs",
    "build:demo": "tsc --noEmit && vite build",
    "prepare": "npm run build:lib",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test scripts/check-parser.ts scripts/check-render.ts"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "engines": {
    "node": ">=18"
  }
}
